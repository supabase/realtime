     "table": "measurements",                              +|                |                                        | 
     "record": {                                           +|                |                                        | 
         "id": 1,                                          +|                |                                        | 
         "user_id": "f4539ebe-c779-5788-bbc1-2421ffaa8954",+|                |                                        | 
         "taken_on": "2026-05-01"                          +|                |                                        | 
     },                                                    +|                |                                        | 
     "schema": "public",                                   +|                |                                        | 
     "columns": [                                          +|                |                                        | 
         {                                                 +|                |                                        | 
             "name": "id",                                 +|                |                                        | 
             "type": "int4"                                +|                |                                        | 
         },                                                +|                |                                        | 
         {                                                 +|                |                                        | 
             "name": "taken_on",                           +|                |                                        | 
             "type": "date"                                +|                |                                        | 
         },                                                +|                |                                        | 
         {                                                 +|                |                                        | 
             "name": "user_id",                            +|                |                                        | 
             "type": "uuid"                                +|                |                                        | 
         }                                                 +|                |                                        | 
     ]                                                     +|                |                                        | 
 }                                                          |                |                                        | 
(1 row)

select clear_wal();
 clear_wal 
-----------
 
(1 row)

insert into public.measurements(id, taken_on, user_id) values (3, '2026-07-01', seed_uuid(1));
-- Same through list_changes_sync
select
    wal ->> 'schema' as schema,
    wal ->> 'table' as table,
    wal -> 'record' as record,
    subscription_ids
from
    realtime.list_changes_sync('partitioned_pub', 'realtime', 100, 1048576);
 schema |    table     |                                         record                                         |            subscription_ids            
--------+--------------+----------------------------------------------------------------------------------------+----------------------------------------
 public | measurements | {"id": 3, "user_id": "f4539ebe-c779-5788-bbc1-2421ffaa8954", "taken_on": "2026-07-01"} | {f4539ebe-c779-5788-bbc1-2421ffaa8954}
(1 row)

alter publication partitioned_pub set (publish_via_partition_root = false);
select pubname, schemaname, tablename from pg_publication_tables where pubname = 'partitioned_pub';
     pubname     | schemaname |     tablename     
-----------------+------------+-------------------
 partitioned_pub | public     | measurements_2026
(1 row)

truncate table realtime.subscription;
insert into realtime.subscription(subscription_id, entity, claims)
select
    seed_uuid(1),
    'public.measurements_2026',
    jsonb_build_object(
        'role', 'authenticated',
        'email', 'example@example.com',
        'sub', seed_uuid(1)::text
    );
select clear_wal();
 clear_wal 
-----------
 
(1 row)

